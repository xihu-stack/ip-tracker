# 复制为 .env 并填写（uvicorn 启动前 export/copy 到环境，或用 --env-file）
OAUTH_ENABLED=1
OAUTH_CLIENT_ID=client-xxxxxxxx
OAUTH_CLIENT_SECRET=xxxxxxxxxxxxxxxx

OAUTH_AUTH_URL=http://10.4.128.19:8080/oauth2/authorize
OAUTH_TOKEN_URL=http://10.4.128.19:8080/oauth2/token
OAUTH_USERINFO_URL=http://10.4.128.19:8080/userinfo
OAUTH_LOGOUT_URL=http://10.4.128.19:8080/connect/logout

# 可选：允许登录的域账号白名单（逗号分隔）；留空 = 不限制
OAUTH_ALLOWED_USERS=

# 可选：本系统 JWT 密钥（不配则每次启动随机，重启后需重新登录）
APP_JWT_SECRET=
